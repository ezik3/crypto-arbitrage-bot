# ──────────────────────────────────────────────────────────────────────────────
# Crypto Arbitrage Bot — Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit your real .env to source control.
# ──────────────────────────────────────────────────────────────────────────────

# ── TRADING MODE ──────────────────────────────────────────────────────────────
# Set to "false" to enable live trading. Default is dry-run (simulation only).
DRY_RUN=true

# Starting capital in USD (e.g. 50 for $50)
INITIAL_CAPITAL_USD=50

# ── EXCHANGE API KEYS ─────────────────────────────────────────────────────────
BINANCE_API_KEY=
BINANCE_API_SECRET=

BYBIT_API_KEY=
BYBIT_API_SECRET=

KRAKEN_API_KEY=
KRAKEN_API_SECRET=

KUCOIN_API_KEY=
KUCOIN_API_SECRET=
KUCOIN_API_PASSPHRASE=

POLONIEX_API_KEY=
POLONIEX_API_SECRET=

GATEIO_API_KEY=
GATEIO_API_SECRET=

# ── BLOCKCHAIN RPC URLs ───────────────────────────────────────────────────────
ETH_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
ETH_BACKUP_RPC_URL=https://mainnet.infura.io/v3/YOUR_INFURA_KEY

BSC_RPC_URL=https://bsc-dataseed1.binance.org
BSC_BACKUP_RPC_URL=https://bsc-dataseed2.binance.org

POLYGON_RPC_URL=https://polygon-rpc.com
ARB_RPC_URL=https://arb1.arbitrum.io/rpc
OP_RPC_URL=https://mainnet.optimism.io

# ── WALLET (for on-chain flash loans / DEX trades) ───────────────────────────
# WARNING: Keep this secret. Use a dedicated bot wallet, not your main wallet.
PRIVATE_KEY=

# ── DATA & ANALYTICS APIs ─────────────────────────────────────────────────────
LIVECOINWATCH_API_KEY=
DAPPRADAR_API_KEY=
QUILLAI_API_KEY=

# ── NOTIFICATIONS ─────────────────────────────────────────────────────────────
# Optional: Telegram alerts for trade signals and errors
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
