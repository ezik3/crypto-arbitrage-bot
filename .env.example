# Crypto Arbitrage Bot Configuration
# Copy this file to .env and fill in your API keys

# ============================================
# EXCHANGE API KEYS
# ============================================

# Binance (Testnet: https://testnet.binance.vision/)
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here

# Bybit (Testnet: https://testnet.bybit.com/)
BYBIT_API_KEY=your_bybit_api_key_here
BYBIT_API_SECRET=your_bybit_api_secret_here

# Kraken
KRAKEN_API_KEY=your_kraken_api_key_here
KRAKEN_API_SECRET=your_kraken_api_secret_here

# Gate.io
GATEIO_API_KEY=your_gateio_api_key_here
GATEIO_API_SECRET=your_gateio_api_secret_here

# KuCoin (optional)
# KUCOIN_API_KEY=your_kucoin_api_key_here
# KUCOIN_API_SECRET=your_kucoin_api_secret_here
# KUCOIN_API_PASSPHRASE=your_kucoin_passphrase_here

# Poloniex (optional)
# POLONIEX_API_KEY=your_poloniex_api_key_here
# POLONIEX_API_SECRET=your_poloniex_api_secret_here

# ============================================
# BOT SETTINGS
# ============================================

# Trading mode
# Set to true for testing with virtual $100
TEST_MODE=true

# Virtual capital for test mode
TOTAL_CAPITAL_USD=100

# Minimum profit percentage to execute trades
MIN_PROFIT_PERCENT=0.5

# Use testnet exchanges (recommended for testing)
USE_TESTNET=true

# ============================================
# RISK MANAGEMENT
# ============================================

# Daily loss limit (in USD)
DAILY_LOSS_LIMIT=10

# Maximum position size (percentage of capital)
MAX_POSITION_SIZE_PERCENT=10

# Maximum number of concurrent trades
MAX_CONCURRENT_TRADES=3

# ============================================
# LOGGING
# ============================================

# Log level: debug, info, warn, error
LOG_LEVEL=info

# Log to file
LOG_TO_FILE=true
LOG_FILE_PATH=./logs/arbitrage.log

# ============================================
# DASHBOARD
# ============================================

# Dashboard port
DASHBOARD_PORT=3000

# Enable WebSocket updates
ENABLE_WEBSOCKET=true

# Update interval (milliseconds)
UPDATE_INTERVAL=5000